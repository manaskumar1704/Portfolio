# Copy to .env and fill in. Never commit .env.

# ---- App (phase 1) ----
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated. The Vercel frontend origin, for CORS.
CORS_ORIGINS=http://localhost:3000

# ---- Database: Neon (phase 2) ----
# The app's URL. Use the POOLED host (it contains -pooler). asyncpg is async,
# and app/db/pool.py rewrites sslmode to ssl for that driver, so paste the Neon
# string exactly as the console gives it to you.
DATABASE_URL=
# Alembic's URL. Use the DIRECT host (no -pooler): migrations run DDL, which
# PgBouncer's transaction pooler can misroute. psycopg is sync and understands
# sslmode and channel_binding as written.
SYNC_DATABASE_URL=

# ---- LLM: Gemini primary, Groq fallback (phase 3) ----
# Which adapter LLMClient builds: gemini | groq
LLM_PROVIDER=gemini
# Verified live: 1M input / 64k output tokens, native function calling.
# Never gemini-2.5-* or older, they are deprecated. See the gemini-api-dev skill.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Fallback for 429s. Groq model names carry a provider prefix, so this is not a
# drop-in string swap for GEMINI_MODEL.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ---- Embeddings, local (phase 4) ----
# 384 dimensions, matching the vector(384) column created by the migration.
# Changing this means re-running ingest; rows written by two models are not
# comparable, which is why ingest_runs records the model that wrote them.
# Verified live: 384 dims, 267 MB peak RSS in the container, 1.4s per query.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ONNX spawns one thread per core otherwise, which on a 0.1-CPU box is slower
# than one thread. Measured, not assumed.
OMP_NUM_THREADS=1

# ---- Corpus (phase 4) ----
# Where the markdown lives. The real corpus lives in its own repository, so
# pointing at it is a path, not a code change.
# CORPUS_DIR=../portfolio-corpus
CORPUS_DIR=corpus
# PDFs live here and are git-ignored. Convert with:
#   uv run python -m ingest.from_pdf --input corpus/_source/resume.pdf --output corpus/resume.md
CORPUS_SOURCE_DIR=corpus/_source

# ---- Tools (phase 5) ----
# A FINE-GRAINED PAT, not a classic token. Create at github.com/settings/personal-
# access-tokens/new with access limited to "Public repositories (read-only)".
# Fine-grained matters: a classic token's scope is the whole account, so a leak
# reads everything, while a fine-grained one reads only what this site publishes.
# The tool cannot read a private repo either way — see GITHUB_OWNER below — but
# the blast radius of a leak is smaller.
GITHUB_TOKEN=
# The allowlist boundary. get_github_repo refuses any repo not under this owner,
# which is what stops a visitor pointing it at arbitrary URLs or spending your
# rate limit on someone else's repositories. Required: startup fails without it.
GITHUB_OWNER=
# Comma-separated repos to pin, as `owner/repo` or a bare `repo` (which is
# expanded with GITHUB_OWNER). Calling get_github_repo with no argument returns
# all of these, which is the answer to "what have you built".
GITHUB_PINS=
# Seconds a repo response stays cached in-process. Star counts do not change by
# the minute, and the limit is per-token across every visitor.
GITHUB_CACHE_TTL=900
# Short on purpose. This tool sits in the path of a streaming answer, so a slow
# GitHub is a slow answer.
GITHUB_TIMEOUT_SECONDS=8
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
# The sender. onboarding@resend.dev delivers ONLY to the account's own address,
# so a recruiter cannot receive anything until a domain is verified. This is a
# setting rather than a code change for exactly that reason.
RESEND_FROM=onboarding@resend.dev

# ---- Guardrails (phase 6) ----
# Requests per minute per IP on public endpoints.
RATE_LIMIT_PER_MINUTE=10
# Token bucket size. A burst this large is allowed before the refill rate bites.
RATE_LIMIT_BURST=10
# Confirmations of a drafted message, per IP per hour. A separate space from the
# chat limiter: approving is rarer and more consequential than asking.
APPROVE_LIMIT_PER_HOUR=3

# ---- Approval identity (phase 6) ----
# Salt for sha256(salt + normalised_visitor_ip). Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The plaintext address is never stored. This salt is what stops the digest being
# reversed by brute force over the IPv4 space, which is small enough to enumerate.
#
# Changing it makes every outstanding draft unapprovable. That is the intended
# failure mode: drafts are abandoned, never sent by someone else.
IP_HASH_SALT=
# Comma-separated CIDRs allowed to set X-Forwarded-For.
#
# EMPTY IS SAFE AND UNUSABLE. Empty means "trust nobody": the send route falls
# back to the socket address, which cannot be forged, so a visitor cannot claim
# any IP. It also breaks approval for everyone, because behind Render the socket
# peer is the proxy for every request on the internet.
#
# Do not guess these. Start PROBE_TOKEN, GET /_probe/headers?token=..., read the
# `peer` value, put it here, unset PROBE_TOKEN, delete app/api/probe.py.
TRUSTED_PROXY_CIDRS=

# TEMPORARY. Bearer for GET /_probe/headers, which reports the socket peer so
# TRUSTED_PROXY_CIDRS can be filled from observation. Empty means the route 404s
# for everyone. Delete the route and unset this once the list is populated.
PROBE_TOKEN=

# The global daily send ceiling. Resend's free tier allows 100/day, so this sits
# under it. The counter is a database row, not process memory — Render spins down
# and an in-memory budget would reset with it.
DAILY_SEND_CAP=70
# Unsent drafts are deleted after this many days regardless of their expiry.
DRAFT_RETENTION_DAYS=7
# Sent and failed rows keep their body for this long, in case a visitor disputes
# a send. Their IP hash is already cleared the moment they are sent.
SENT_ROW_RETENTION_DAYS=30
# Percent of /chat requests that also run the retention sweep. There is no cron
# on this tier, so container boot plus this is the whole schedule. The
# consequence, stated rather than hidden: a site with no traffic does not sweep.
RETENTION_SWEEP_PERCENT=2

# ---- Tracing: Langfuse (phase 8, no-op until set) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- MCP server (phase 7) ----
# Bearer token the MCP server presents. Separate from any user login: this is
# one client, the user, and the server runs on their machine.
MCP_AUTH_TOKEN=