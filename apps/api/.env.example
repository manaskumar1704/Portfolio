# AI Portfolio API — copy to .env, fill in. NEVER commit .env.
# "REQUIRED" = production refuses to boot without it (APP_ENV=production).

# ---- App ----
APP_ENV=local                        # "production" turns on the boot checks
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000   # REQUIRED: exact Vercel origin(s), comma-separated, no wildcards

# ---- Neon Postgres ----
# Pooled host (-pooler) for the app; direct host for migrations. Paste exactly
# as Neon gives it — plain postgresql:// URLs go to their driver untouched.
DATABASE_URL=                        # REQUIRED: pooled
SYNC_DATABASE_URL=                   # REQUIRED: direct (no -pooler); Alembic runs DDL

# ---- LLM ----
LLM_PROVIDER=gemini                  # gemini | groq
GEMINI_MODEL=gemini-3.5-flash-lite   # never gemini-2.5-* or older (deprecated)
GEMINI_API_KEY=                      # REQUIRED unless LLM_PROVIDER=groq: https://aistudio.google.com/apikey
GROQ_API_KEY=                        # optional 429 fallback; groq model names carry a provider prefix
LLM_MAX_ATTEMPTS=2                   # tries per provider before the turn switches to the other one (1-5)

# ---- Embeddings (local, ONNX) ----
# Both must match the vector(384) column; a mismatch degrades retrieval
# silently. Changing either means re-running ingest. OMP=1 on the 0.1-CPU
# Render tier.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
OMP_NUM_THREADS=1

# ---- Corpus (ingest-time only) ----
CORPUS_DIR=corpus
CORPUS_SOURCE_DIR=corpus/_source     # PDFs, git-ignored; convert: python -m ingest.from_pdf

# ---- GitHub tool ----
GITHUB_TOKEN=                        # fine-grained PAT, scope "Public repositories (read-only)"; never classic
GITHUB_OWNER=                        # REQUIRED: tool allowlist boundary
GITHUB_PINS=                         # comma-separated repo names to demo
GITHUB_CACHE_TTL=900
GITHUB_TIMEOUT_SECONDS=8             # short: this tool sits inside a streaming answer

# ---- Email (Resend) ----
RESEND_API_KEY=                      # REQUIRED as a pair with the next line
CONTACT_NOTIFY_EMAIL=                # REQUIRED as a pair; where drafts are delivered
RESEND_FROM=onboarding@resend.dev    # delivers only to your own address until a domain is verified

# ---- Limits ----
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_BURST=15
APPROVE_LIMIT_PER_HOUR=3
DAILY_SEND_CAP=70                    # Resend free = 100/day; stays under it
IP_DAILY_SEND_CAP=2

# ---- Retention (no cron on this tier; sweep runs on boot + per-request chance) ----
DRAFT_RETENTION_DAYS=7
SENT_ROW_RETENTION_DAYS=30
RETENTION_SWEEP_PERCENT=2

# ---- Approval identity ----
# python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SALT=                        # REQUIRED: >= 16 chars; rotating it voids pending drafts (intended)
TRUSTED_PROXY_CIDRS=                 # DO NOT GUESS: fill from GET /_probe/headers after first deploy (DEPLOY step 12)
PROBE_TOKEN=                         # temporary, only for step 12; empty afterwards

# ---- Tracing: Langfuse (this app's own run trace; no-op until set) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
