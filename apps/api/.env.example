# Copy to .env and fill in. Never commit .env.

# ---- App (phase 1) ----
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated. The Vercel frontend origin, for CORS.
CORS_ORIGINS=http://localhost:3000

# ---- Database: Neon (phase 2) ----
# Use the POOLED connection string. Strip the -pool suffix for alembic.
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Synchronous driver, same host, for Alembic. Left empty until phase 2.
SYNC_DATABASE_URL=

# ---- LLM: Groq primary, Gemini fallback (phase 3) ----
# Which adapter LLMClient builds: groq | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Embeddings, local (phase 4) ----
# 384 dimensions, all-MiniLM-L6-v2. Changing this means re-running ingest.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ONNX spawns one thread per core otherwise, which is what blows the 512 MB box.
OMP_NUM_THREADS=1

# ---- Tools (phase 5) ----
# Fine-grained PAT, public_repo read only. Raises the 60 req/hr anonymous cap.
GITHUB_TOKEN=
# Comma-separated repos. get_github_repo with no argument returns these.
GITHUB_PINS=manas-dev/Portfolio,manaskumar1704/mcp-job-tools
# Where send_message notifications are delivered.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# ---- Guardrails (phase 6) ----
# Requests per minute per IP on public endpoints.
RATE_LIMIT_PER_MINUTE=10
# Token bucket size. A burst this large is allowed before the refill rate bites.
RATE_LIMIT_BURST=10
# Confirmations of a drafted message, per IP per hour.
APPROVE_LIMIT_PER_HOUR=3

# ---- Tracing: Langfuse (phase 8, no-op until set) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- MCP server (phase 7) ----
# Bearer token the MCP server presents. Separate from any user login: this is
# one client, the user, and the server runs on their machine.
MCP_AUTH_TOKEN=