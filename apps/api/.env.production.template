# Production configuration template. NO VALUES — this file is a checklist.
#
# Where it goes:
#   * Render dashboard  -> Environment tab of the `portfolio-api` service
#   * NOT committed, NOT in git, NOT in apps/api/.env
#
# Every name below matches a field of `Settings` in apps/api/app/core/config.py,
# which is the only place in `app/` that reads the environment. If a variable is
# not listed here, it is either not needed by the API at runtime, or it does not
# exist.
#
# Lines starting `#` are read this way:
#   [ ] must be set   -> the app REFUSES TO BOOT without it (APP_ENV=production)
#   [ ] set it        -> required for a feature to work; boot succeeds without
#   [ ] temporary     -> set for one step, then removed
#
# ── Generate the random ones with these commands ────────────────────────────
#
#   IP_HASH_SALT   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   PROBE_TOKEN    python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Copy the printed value. Do not commit it. Do not paste it into a chat.


# ═══ Application ════════════════════════════════════════════════════════════

# [ ] must be set. "production" turns on the boot checks below.
APP_ENV=production

# [ ] set it. INFO is fine; DEBUG logs every SQL statement and every tool result.
LOG_LEVEL=INFO


# ═══ CORS ═══════════════════════════════════════════════════════════════════

# [ ] must be set. Exact origins, comma-separated. NO WILDCARDS.
#
# Your Vercel production URL only, e.g. https://your-site.vercel.app
#
# The app compares whole strings, so https://example.com.evil.test is not
# covered by https://example.com. That is the point.
#
# To test a Vercel preview: add that preview's exact origin here (comma-separated
# with the production one), save, wait for the redeploy, test, then remove the
# preview origin. There is deliberately no wildcard option.
#
# Get it from: Vercel dashboard -> your project -> the production URL.
CORS_ORIGINS=


# ═══ Neon Postgres ══════════════════════════════════════════════════════════
#
# THE TWO URLs ARE NOT INTERCHANGEABLE.
#
# Neon gives you a "pooled" connection string (hostname contains -pooler) and a
# "direct" one. Use each for exactly one purpose:
#
#   DATABASE_URL       -> POOLED   (the -pooler host)
#   SYNC_DATABASE_URL  -> DIRECT   (the host without -pooler)
#
# Why: the app holds a small pool of connections and PgBouncer multiplexes many
# visitors onto few Postgres backends. Alembic runs DDL, and a transaction
# pooler can route a schema change to the wrong backend, so migrations go
# straight to Postgres instead.
#
# Get both from: Neon console -> your project -> Connection Details. Copy the
# full string including ?sslmode=... — the app rewrites what asyncpg needs.
#
# Which branch: PRODUCTION credentials go here. The dev branch's credentials go
# in apps/api/.env and in GitHub Actions secrets, and never in Render.
#
# [ ] must be set.
DATABASE_URL=
# [ ] must be set. Without it Alembic cannot run and the container will not start.
SYNC_DATABASE_URL=


# ═══ LLM: Gemini primary, Groq fallback ═════════════════════════════════════

# [ ] set it. "gemini" or "groq".
LLM_PROVIDER=gemini

# [ ] set it. Verified live: 1M input tokens, native function calling.
# Never a 2.5 or older model — they are deprecated.
GEMINI_MODEL=gemini-3.5-flash-lite

# [ ] must be set (unless LLM_PROVIDER=groq). Without it the app boots and then
# fails on the first visitor's question.
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [ ] set it. The 429 fallback. Optional: the app runs fine without it, it just
# has no fallback when Gemini rate-limits.
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=


# ═══ Embeddings ═════════════════════════════════════════════════════════════

# [ ] set it. Must match the model that produced the vectors in the database.
# Changing it means re-running ingest, not a redeploy.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# [ ] set it. Must match the vector column, which is vector(384).
# A mismatch does not error. It makes distances between vectors from two models
# meaningless, and answers quietly get worse.
EMBEDDING_DIMENSIONS=384

# [ ] set it. ONNX spawns one thread per core otherwise, and on a 0.1-CPU box
# that is slower than one thread. Measured, not assumed.
OMP_NUM_THREADS=1


# ═══ Approval identity ═════════════════════════════════════════════════════

# [ ] must be set. At least 16 characters; generate it with the command at the
# top of this file.
#
# This is what makes the stored visitor IP hash un-reversible by brute force over
# the IPv4 space. Losing it makes every outstanding draft unapprovable, which is
# the intended outcome: drafts are abandoned, never sent by someone else.
IP_HASH_SALT=

# [ ] set it, but it STARTS EMPTY and that is safe.
#
# Empty means "trust nobody": the send route ignores X-Forwarded-For and compares
# against the socket peer, which cannot be forged. It also breaks approving for
# everyone, because behind Render the peer is the proxy for every request.
#
# Do NOT guess this. Set PROBE_TOKEN below, deploy, then:
#     curl "https://YOUR-SERVICE.onrender.com/_probe/headers?token=YOUR_TOKEN"
# Put the `peer` value here, then remove PROBE_TOKEN.
# See docs/DEPLOY.md, step 12.
TRUSTED_PROXY_CIDRS=


# ═══ GitHub ═════════════════════════════════════════════════════════════════

# [ ] set it. A FINE-GRAINED PAT, not a classic token — a classic token's scope
# is your whole account, so a leak reads everything.
# Get it from: https://github.com/settings/personal-access-tokens/new
# Scope: "Public repositories (read-only)".
#
# Not boot-blocking: without it the tool reports "unavailable" to the model and
# the rest of the site works.
GITHUB_TOKEN=

# [ ] set it. The allowlist boundary. get_github_repo refuses any repo not under
# this owner, which is what stops a visitor spending your rate limit.
GITHUB_OWNER=

# [ ] set it. Which repos to demo, comma-separated, as owner/repo or a bare name.
# Empty means the tool has nothing to list.
GITHUB_PINS=

# [ ] set it. Optional tuning, safe defaults.
GITHUB_CACHE_TTL=900
GITHUB_TIMEOUT_SECONDS=8


# ═══ Email (Resend) ════════════════════════════════════════════════════════

# [ ] must be set as a PAIR. One without the other is a typo and the app refuses
# to boot.
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=

# [ ] must be set as a pair. Where notifications are delivered. For now: your own
# inbox, which is the point — this sends to you, not to strangers.
CONTACT_NOTIFY_EMAIL=

# [ ] set it. onboarding@resend.dev delivers ONLY to the account's own address.
# Messages will reach you and nobody else until you verify a domain.
# Verify at https://resend.com/domains, then change this value. No code change.
RESEND_FROM=onboarding@resend.dev


# ═══ Limits ═════════════════════════════════════════════════════════════════

# [ ] set it. Requests per minute per IP on public endpoints.
RATE_LIMIT_PER_MINUTE=10
# [ ] set it. Token bucket size.
RATE_LIMIT_BURST=10
# [ ] set it. Approvals per IP per hour. Separate space from the chat limiter.
APPROVE_LIMIT_PER_HOUR=3
# [ ] set it. Resend's free tier allows 100/day; this sits under it.
DAILY_SEND_CAP=70


# ═══ Retention ══════════════════════════════════════════════════════════════

# [ ] set it. Unsent drafts are deleted after this many days regardless of expiry.
DRAFT_RETENTION_DAYS=7
# [ ] set it. Sent and failed rows keep their body this long. Their IP hash is
# already cleared the moment they are sent.
SENT_ROW_RETENTION_DAYS=30
# [ ] set it. Percent of /chat requests that also run the retention sweep.
# There is no cron on this tier, so container boot plus this is the schedule.
RETENTION_SWEEP_PERCENT=2


# ═══ Temporary ══════════════════════════════════════════════════════════════

# [ ] temporary. Bearer for GET /_probe/headers. EMPTY means the route 404s for
# everyone, which is correct for every deploy except step 12 of docs/DEPLOY.md.
#
# Set it, deploy, read `peer`, populate TRUSTED_PROXY_CIDRS, then REMOVE THIS.
PROBE_TOKEN=


# ═══ Not needed by the API at runtime ══════════════════════════════════════

# CORPUS_DIR and CORPUS_SOURCE_DIR are ingest-only. The corpus is read at build
# time by `uv run python -m ingest.run`, not by the running app.
#
# LANGFUSE_* is phase 8 tracing. All empty means tracing is a no-op.
# MCP_AUTH_TOKEN is phase 7. Neither is needed now; add them when the phase lands
# rather than carrying unused configuration.